# Copy this file to .env for LOCAL development only. .env is in .gitignore.
# In AWS these values come from SSM Parameter Store under /fintrust/dev/.
# Placeholders only: never put a real secret in this file.

AWS_REGION=eu-north-1
FINTRUST_ENV=dev

# Local runs and tests do not call SSM
FINTRUST_SSM_ENABLED=false

# Local PostgreSQL (docker compose), password auth. AWS uses IAM auth instead.
FINTRUST_DB_AUTH_MODE=password
FINTRUST_DB_HOST=localhost
FINTRUST_DB_PORT=5432
FINTRUST_DB_NAME=fintrust
FINTRUST_DB_USER=fintrust_local
FINTRUST_DB_PASSWORD=change-me-local-only

FINTRUST_RAW_BUCKET=fintrust-capstone-raw-000000000000
FINTRUST_PROCESSED_BUCKET=fintrust-capstone-processed-000000000000
FINTRUST_QUARANTINE_BUCKET=fintrust-capstone-quarantine-000000000000
FINTRUST_REPORTS_BUCKET=fintrust-capstone-reports-000000000000
FINTRUST_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/000000000000/fintrust-capstone-transactions.fifo
FINTRUST_DYNAMO_TABLE=fintrust-capstone-events
FINTRUST_ALERT_SENDER=you@example.com
FINTRUST_ALERT_RECIPIENT=you@example.com
