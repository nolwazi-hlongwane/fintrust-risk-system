{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# FinTrust transaction pipeline\nCSV upload \u2192 **ingest** (validate) \u2192 SQS FIFO queue \u2192 **score** (ledger + risk score) \u2192 **alert** (email for HIGH risk). Rows read should equal rows queued plus rows quarantined. Any message in a dead-letter queue needs a person to look at it."
      }
    },
    {
      "type": "alarm",
      "x": 0,
      "y": 2,
      "width": 24,
      "height": 3,
      "properties": {
        "title": "Alarms",
        "alarms": [
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-scoring-error-rate",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-high-risk-count",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-transactions-dlq-depth",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-ingest-dlq-depth",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-alert-dlq-depth",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-lambda-errors",
          "arn:aws:cloudwatch:__REGION__:__ACCOUNT_ID__:alarm:__PREFIX__-api-5xx-errors"
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 5,
      "width": 24,
      "height": 3,
      "properties": {
        "title": "Totals for the selected time range",
        "region": "__REGION__",
        "view": "singleValue",
        "stat": "Sum",
        "period": 300,
        "setPeriodToTimeRange": true,
        "metrics": [
          [
            "FinTrust/ETL",
            "RowsRead",
            "Environment",
            "__ENV__",
            {
              "label": "Rows read"
            }
          ],
          [
            "FinTrust/ETL",
            "RowsQuarantined",
            "Environment",
            "__ENV__",
            {
              "label": "Rows quarantined"
            }
          ],
          [
            "FinTrust/ETL",
            "TransactionsScored",
            "Environment",
            "__ENV__",
            {
              "label": "Transactions scored"
            }
          ],
          [
            "FinTrust/ETL",
            "HighRiskTransactions",
            "Environment",
            "__ENV__",
            {
              "label": "High risk"
            }
          ],
          [
            "FinTrust/ETL",
            "AlertsSent",
            "Environment",
            "__ENV__",
            {
              "label": "Alert emails sent"
