    {
      "type": "metric",
      "x": 16,
      "y": 20,
      "width": 8,
      "height": 6,
      "properties": {
        "title": "Scoring error rate (%)",
        "region": "__REGION__",
        "view": "timeSeries",
        "stacked": false,
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            {
              "expression": "IF(failures + scored > 0, 100 * failures / (failures + scored), 0)",
              "label": "Error rate (%)",
              "id": "rate",
              "period": 300
            }
          ],
          [
            "FinTrust/ETL",
            "ScoringFailures",
            "Environment",
            "__ENV__",
            {
              "id": "failures",
              "visible": false,
              "period": 300
            }
          ],
          [
            "FinTrust/ETL",
            "TransactionsScored",
            "Environment",
            "__ENV__",
            {
              "id": "scored",
              "visible": false,
              "period": 300
            }
          ]
        ],
        "annotations": {
          "horizontal": [
            {
              "label": "Alarm threshold",
              "value": 5
            }
          ]
        }
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 26,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Latest errors and warnings from all five functions",
        "region": "__REGION__",
        "view": "table",
        "query": "SOURCE '/aws/lambda/__PREFIX__-ingest' | SOURCE '/aws/lambda/__PREFIX__-score' | SOURCE '/aws/lambda/__PREFIX__-alert' | SOURCE '/aws/lambda/__PREFIX__-query' | SOURCE '/aws/lambda/__PREFIX__-report' | fields @timestamp, service, level, message, transaction_id, source_key, error | filter level in ['ERROR', 'WARNING'] | sort @timestamp desc | limit 25"
      }
    }
