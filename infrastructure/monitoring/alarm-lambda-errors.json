    "MetricStat": {
      "Metric": {
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [{"Name": "FunctionName", "Value": "__PREFIX__-score"}]
      },
      "Period": 300,
      "Stat": "Sum"
    }
  },
  {
    "Id": "alert",
    "ReturnData": false,
    "MetricStat": {
      "Metric": {
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [{"Name": "FunctionName", "Value": "__PREFIX__-alert"}]
      },
      "Period": 300,
      "Stat": "Sum"
    }
  },
  {
    "Id": "query",
    "ReturnData": false,
    "MetricStat": {
      "Metric": {
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [{"Name": "FunctionName", "Value": "__PREFIX__-query"}]
      },
      "Period": 300,
      "Stat": "Sum"
