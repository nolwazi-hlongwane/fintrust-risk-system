    "MetricStat": {
      "Metric": {
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [{"Name": "FunctionName", "Value": "__PREFIX__-ingest"}]
      },
      "Period": 300,
      "Stat": "Sum"
    }
  },
  {
