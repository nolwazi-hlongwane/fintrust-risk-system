    "/upload": {
      "post": {
        "summary": "Submit a CSV file for processing. Answers 202 at once; processing continues in the background",
        "security": [
          {
            "api_key": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "403": {
            "description": "Missing or invalid API key"
          },
          "413": {
            "description": "File larger than 5 MB"
          },
          "429": {
            "description": "Usage plan limit reached"
          },
          "500": {
            "description": "Unexpected error"
          },
          "503": {
            "description": "The file could not be stored"
