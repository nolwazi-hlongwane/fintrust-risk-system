    "title": "__PREFIX__-api",
    "version": "1.0",
    "description": "FinTrust Transaction Insights and Risk Monitoring API. Every route except OPTIONS needs the dashboard's API key in the x-api-key header (usage plan). Every route except GET /health and OPTIONS also needs a signed-in person's Amazon Cognito ID token in the Authorization header. The query Lambda then checks the person's session and role."
  },
  "x-amazon-apigateway-api-key-source": "HEADER",
