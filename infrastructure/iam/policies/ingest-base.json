{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogGroupOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/lambda/__PREFIX__-ingest:*"
    },
    {
      "Sid": "XRayTracing",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnConfigFromParameterStore",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/fintrust/__ENV__",
        "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/fintrust/__ENV__/*"
      ]
    }
  ]
}
