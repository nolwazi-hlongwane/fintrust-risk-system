{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LogsAndTracing",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    },
    {
      "Sid": "VpcNetworkInterfaces",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSubnets",
        "ec2:DeleteNetworkInterface",
        "ec2:AssignPrivateIpAddresses",
        "ec2:UnassignPrivateIpAddresses"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ConfigFromParameterStore",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/fintrust",
        "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:parameter/fintrust/*"
      ]
    },
    {
      "Sid": "ProjectBucketsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::__PREFIX__-*",
        "arn:aws:s3:::__PREFIX__-*/*"
      ]
    },
    {
      "Sid": "ProjectQueuesOnly",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:__REGION__:__ACCOUNT_ID__:__PREFIX__-*"
    },
    {
      "Sid": "ProjectTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream"
      ],
      "Resource": [
        "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/__PREFIX__-*",
        "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/__PREFIX__-*/index/*",
        "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/__PREFIX__-*/stream/*"
      ]
    },
    {
      "Sid": "EncryptionKeyUse",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:__REGION__:__ACCOUNT_ID__:key/*"
    },
    {
      "Sid": "DatabaseLoginWithIamToken",
      "Effect": "Allow",
      "Action": [
        "rds-db:connect"
      ],
      "Resource": "arn:aws:rds-db:__REGION__:__ACCOUNT_ID__:dbuser:*/fintrust_*"
    },
    {
      "Sid": "AlertEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail"
      ],
      "Resource": "arn:aws:ses:__REGION__:__ACCOUNT_ID__:identity/*"
    },
    {
      "Sid": "ListTableStreams",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListStreams"
      ],
      "Resource": "*"
    }
  ]
}
