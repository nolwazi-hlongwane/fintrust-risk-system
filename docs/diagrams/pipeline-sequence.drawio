        <mxCell id="m-8" value="9: batch of messages (Lambda polls the queue)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="976" y="534" as="sourcePoint"/><mxPoint x="1185" y="534" as="targetPoint"/></mxGeometry></mxCell>
