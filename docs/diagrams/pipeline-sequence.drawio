        <mxCell id="m-16" value="17: journey: ALERT_SENT" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1827" y="870" as="sourcePoint"/><mxPoint x="1618" y="870" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-17" value="18: message delivered" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="976" y="940" as="sourcePoint"/><mxPoint x="1185" y="940" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-18" value="19: ROLLBACK: nothing is half-written" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="980" as="sourcePoint"/><mxPoint x="1404" y="980" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-19" value="20: journey: SCORE_FAILED (attempt n)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1020" as="sourcePoint"/><mxPoint x="1618" y="1020" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-20" value="21: batchItemFailures: [message id]" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="1060" as="sourcePoint"/><mxPoint x="976" y="1060" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n-21" value="SQS shows the message again after the visibility timeout. After 3 failed attempts it moves to the FIFO dead-letter queue and a CloudWatch alarm emails the team." style="shape=note;whiteSpace=wrap;html=1;size=12;fontFamily=Helvetica;fontSize=11;fillColor=#FFF8E1;strokeColor=#A6792B;fontColor=#232F3E;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="886" y="1086" width="394" height="46" as="geometry"/></mxCell>
        <mxCell id="n-22" value="Recovery: fix the cause (scripts/onboard_account.py), then scripts/redrive_dlq.sh moves the messages back. They are scored with no data re-entered." style="shape=note;whiteSpace=wrap;html=1;size=12;fontFamily=Helvetica;fontSize=11;fillColor=#FFF8E1;strokeColor=#A6792B;fontColor=#232F3E;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="886" y="1142" width="608" height="46" as="geometry"/></mxCell>
