        <mxCell id="m-12" value="13: committed" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1399" y="710" as="sourcePoint"/><mxPoint x="1195" y="710" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-13" value="14: PutItem score + rule breakdown; journey: SCORED" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="750" as="sourcePoint"/><mxPoint x="1618" y="750" as="targetPoint"/></mxGeometry></mxCell>
