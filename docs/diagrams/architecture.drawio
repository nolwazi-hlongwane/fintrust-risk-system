        </mxCell>
        <mxCell id="cloudtrail" value="&lt;b&gt;CloudTrail&lt;/b&gt;&lt;br&gt;audit: who changed what&lt;br&gt;in the account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;fontColor=#1f2937;fontSize=12;" vertex="1" parent="1">
