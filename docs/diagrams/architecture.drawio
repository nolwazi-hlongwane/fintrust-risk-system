        <mxCell id="support-0" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;logs, FinTrust/ETL metrics, alarms&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="912" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="support-0-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="310" y="922.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="support-1" value="&lt;b&gt;AWS X-Ray&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;traces: API stage, every Lambda&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#C925D1;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="574" y="912" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="support-1-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;" vertex="1" parent="1"><mxGeometry x="584" y="922.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="support-2" value="&lt;b&gt;Amazon SNS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;alarm emails, encrypted topic&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="848" y="912" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="support-2-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" vertex="1" parent="1"><mxGeometry x="858" y="922.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="support-3" value="&lt;b&gt;AWS KMS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;customer key: S3, SQS, SNS&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1122" y="912" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="support-3-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="1132" y="922.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="support-4" value="&lt;b&gt;SSM Parameter Store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;settings, no secrets in code&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1396" y="912" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="support-4-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="1406" y="922.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="support-5" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;stops RDS + tunnel at 20:00&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1670" y="912" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="support-5-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1"><mxGeometry x="1680" y="922.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="global-title" value="&lt;b&gt;Global services&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="300" y="1008" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="global-iam" value="&lt;b&gt;AWS IAM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;one least-privilege role per Lambda&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="300" y="1030" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="global-iam-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="310" y="1040.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="global-cloudtrail" value="&lt;b&gt;AWS CloudTrail&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:11px&quot;&gt;who changed what in the account&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;spacingLeft=56;spacingRight=4;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="574" y="1030" width="256" height="58" as="geometry"/></mxCell>
        <mxCell id="global-cloudtrail-icon" value="" style="sketch=0;points=[];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#FFFFFF;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudtrail;" vertex="1" parent="1"><mxGeometry x="584" y="1040.0" width="38" height="38" as="geometry"/></mxCell>
        <mxCell id="free-tier" value="&lt;b&gt;Free Tier sizing:&lt;/b&gt; RDS db.t3.micro, stopped every night · DynamoDB 15 of 25 read and 25 of 25 write units · gateway endpoints instead of a NAT Gateway (about $32 a month saved) · Cognito Essentials, 10 000 monthly users free" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="880" y="1040" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="key-title" value="&lt;b&gt;How one transaction travels&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2370" y="70" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="key-1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="100" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-1-text" value="Staff sign in with a password and an authenticator code. Cognito issues an ID token for 30 minutes." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="102" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="key-2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="146" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-2-text" value="The dashboard loads from CloudFront; its bucket stays private." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="148" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="key-3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="192" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-3-text" value="Every API call carries the API key (which application) and the ID token (which person). The query Lambda checks the session and the role." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="194" width="330" height="48" as="geometry"/></mxCell>
        <mxCell id="key-4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="254" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-4-text" value="POST /upload stores the CSV in the raw bucket, through the S3 gateway endpoint." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="256" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="key-5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="300" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-5-text" value="The S3 event starts the ingest Lambda. Invalid rows go to quarantine with the reason." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="302" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="key-6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="346" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-6-text" value="One message per valid transaction, grouped by account so its order is kept." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="348" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="key-7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="392" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-7-text" value="The score Lambda applies the rules and writes the ledger in one database transaction, then the score and its rule breakdown to DynamoDB." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="394" width="330" height="48" as="geometry"/></mxCell>
        <mxCell id="key-8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="454" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-8-text" value="The DynamoDB Stream passes HIGH scores to the alert Lambda, which emails compliance through SES." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="456" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="key-9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="2370" y="500" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="key-9-text" value="On the 1st of each month EventBridge runs the report Lambda; CSV and JSON go to the reports bucket." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2402" y="502" width="330" height="32" as="geometry"/></mxCell>
        <mxCell id="legend-title" value="&lt;b&gt;Arrows&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2370" y="552" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="legend-flow" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#232F3E;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2370" y="588" as="sourcePoint"/><mxPoint x="2426" y="588" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="legend-flow-text" value="data or a request" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2438" y="580" width="290" height="16" as="geometry"/></mxCell>
        <mxCell id="legend-failure" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#B42318;strokeWidth=1.4;dashed=1;dashPattern=6 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2370" y="612" as="sourcePoint"/><mxPoint x="2426" y="612" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="legend-failure-text" value="failure path: nothing is lost" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2438" y="604" width="290" height="16" as="geometry"/></mxCell>
        <mxCell id="legend-control" value="" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#545B64;strokeWidth=1.2;dashed=1;dashPattern=2 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2370" y="636" as="sourcePoint"/><mxPoint x="2426" y="636" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="legend-control-text" value="check, schedule or admin access" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2438" y="628" width="290" height="16" as="geometry"/></mxCell>
        <mxCell id="legend-failure-card" value="dead-letter queue" style="rounded=1;arcSize=10;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#B42318;dashed=1;dashPattern=6 3;strokeWidth=1.5;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2370" y="668" width="140" height="28" as="geometry"/></mxCell>
        <mxCell id="legend-failure-card-text" value="keeps what failed until it is fixed" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2522" y="674" width="210" height="16" as="geometry"/></mxCell>
        <mxCell id="notes-title" value="&lt;b&gt;Security and network&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2370" y="720" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="note-0" value="• No NAT Gateway and no internet route. The three VPC Lambdas reach S3 and DynamoDB through free gateway endpoints, and log in to PostgreSQL with IAM database authentication: no database password exists." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2370" y="748" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="note-1" value="• Security groups: the Lambda group has no inbound rules; the RDS group accepts port 5432 only from the Lambda group and the tunnel instance." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2370" y="838" width="360" height="48" as="geometry"/></mxCell>
        <mxCell id="note-2" value="• Journey steps (received, validated, queued, scored, alert sent, and every failure) are written to the events table by the ingest, score and alert Lambdas." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="2370" y="896" width="360" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
