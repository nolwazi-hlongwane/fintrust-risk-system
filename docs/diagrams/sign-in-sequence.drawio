        <mxCell id="bar-6" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="971" y="840" width="10" height="96" as="geometry"/></mxCell>
        <mxCell id="bar-7" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="757" y="1036" width="10" height="176" as="geometry"/></mxCell>
        <mxCell id="bar-8" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="971" y="1076" width="10" height="96" as="geometry"/></mxCell>
        <mxCell id="m-0" value="1: Sign in to the risk desk" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="180" as="sourcePoint"/><mxPoint x="329" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-1" value="" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endArrow=block;endFill=1;endSize=8;align=left;spacingLeft=4;labelBackgroundColor=none;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="344" y="220" as="sourcePoint"/><mxPoint x="344" y="242" as="targetPoint"/><Array as="points"><mxPoint x="379" y="220"/><mxPoint x="379" y="242"/></Array></mxGeometry></mxCell>
        <mxCell id="m-1-text" value="2: random state and PKCE verifier; challenge = SHA-256(verifier)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="387" y="218" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="m-2" value="3: GET /oauth2/authorize (client id, challenge, state)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="276" as="sourcePoint"/><mxPoint x="543" y="276" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-3" value="4: username and password, then the 6-digit authenticator code" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="316" as="sourcePoint"/><mxPoint x="543" y="316" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-4" value="5: redirect back: one-time code + the same state" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="543" y="356" as="sourcePoint"/><mxPoint x="339" y="356" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-5" value="" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endArrow=block;endFill=1;endSize=8;align=left;spacingLeft=4;labelBackgroundColor=none;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="344" y="396" as="sourcePoint"/><mxPoint x="344" y="418" as="targetPoint"/><Array as="points"><mxPoint x="379" y="396"/><mxPoint x="379" y="418"/></Array></mxGeometry></mxCell>
        <mxCell id="m-5-text" value="6: the state must match, or the answer is refused" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="387" y="394" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="m-6" value="7: POST /oauth2/token (code + verifier)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="452" as="sourcePoint"/><mxPoint x="543" y="452" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-7" value="8: ID token (30 minutes) + refresh token (8 hours)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="543" y="492" as="sourcePoint"/><mxPoint x="339" y="492" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-8" value="9: POST /session (x-api-key, Authorization: ID token)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="532" as="sourcePoint"/><mxPoint x="757" y="532" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-9" value="" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endArrow=block;endFill=1;endSize=8;align=left;spacingLeft=4;labelBackgroundColor=none;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="572" as="sourcePoint"/><mxPoint x="772" y="594" as="targetPoint"/><Array as="points"><mxPoint x="807" y="572"/><mxPoint x="807" y="594"/></Array></mxGeometry></mxCell>
        <mxCell id="m-9-text" value="10: API key and usage plan; token signature, issuer and expiry" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="815" y="570" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="m-10" value="11: request + claims: username, groups, origin_jti" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="767" y="628" as="sourcePoint"/><mxPoint x="971" y="628" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-11" value="12: PutItem if not exists (session_id = origin_jti)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="981" y="668" as="sourcePoint"/><mxPoint x="1190" y="668" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-12" value="13: 201: name, role, permissions" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="971" y="708" as="sourcePoint"/><mxPoint x="767" y="708" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-13" value="14: 201" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="757" y="748" as="sourcePoint"/><mxPoint x="339" y="748" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-14" value="15: GET /transactions + ID token (renewed before it expires)" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="806" as="sourcePoint"/><mxPoint x="757" y="806" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-15" value="16: request + claims" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="767" y="846" as="sourcePoint"/><mxPoint x="971" y="846" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-16" value="17: GetItem: ACTIVE? idle under 15 minutes? under 8 hours?" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="981" y="886" as="sourcePoint"/><mxPoint x="1190" y="886" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-17" value="18: 200 rows · 401 SESSION_ENDED · 403 wrong role" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="971" y="926" as="sourcePoint"/><mxPoint x="767" y="926" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-18" value="19: response" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="757" y="966" as="sourcePoint"/><mxPoint x="339" y="966" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-19" value="20: DELETE /session" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="1042" as="sourcePoint"/><mxPoint x="757" y="1042" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-20" value="21: request + claims" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="767" y="1082" as="sourcePoint"/><mxPoint x="971" y="1082" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-21" value="22: UpdateItem: status ENDED, reason SIGNED_OUT or IDLE" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="981" y="1122" as="sourcePoint"/><mxPoint x="1190" y="1122" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-22" value="23: 200: session ended" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="971" y="1162" as="sourcePoint"/><mxPoint x="767" y="1162" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-23" value="24: 200" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="757" y="1202" as="sourcePoint"/><mxPoint x="339" y="1202" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m-24" value="25: POST /oauth2/revoke (refresh token), then GET /logout" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#232F3E;strokeColor=#232F3E;strokeWidth=1.2;endSize=8;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="339" y="1242" as="sourcePoint"/><mxPoint x="548" y="1242" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n-25" value="The same ID token used again before it expires gets 401 SESSION_ENDED: the session record, not the token, decides." style="shape=note;whiteSpace=wrap;html=1;size=12;fontFamily=Helvetica;fontSize=11;fillColor=#FFF8E1;strokeColor=#A6792B;fontColor=#232F3E;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="244" y="1268" width="1036" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
