        <mxCell id="frame-0" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;width=52;height=22;boundedLbl=1;verticalAlign=middle;align=center;fillColor=none;swimlaneFillColor=none;strokeColor=#545B64;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="238" y="766" width="1048" height="228" as="geometry"/></mxCell>
