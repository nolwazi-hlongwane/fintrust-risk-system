        <mxCell id="dd-0-4" value="risk_score : N, risk_level : S, rules : L&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;on SCORE items; the Stream filters on risk_level&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-0"><mxGeometry x="0" y="180" width="388" height="34" as="geometry"/></mxCell>
        <mxCell id="dd-0-5" value="stage : S, at : S, detail : S&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;on EVENT items: one step of the journey&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-0"><mxGeometry x="0" y="214" width="388" height="34" as="geometry"/></mxCell>
        <mxCell id="dd-0-6" value="expires_at : N&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;time-to-live: deleted after 12 months&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-0"><mxGeometry x="0" y="248" width="388" height="34" as="geometry"/></mxCell>
        <mxCell id="dd-1" value="«DynamoDB table»&lt;br&gt;&lt;b&gt;fintrust-capstone-sessions&lt;/b&gt;" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#F7EAF8;swimlaneFillColor=#FFFFFF;strokeColor=#C925D1;strokeWidth=1.5;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1196" y="720" width="388" height="248" as="geometry"/></mxCell>
        <mxCell id="dd-1-0" value="«PK» session_id : S&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;the sign-in&amp;#x27;s origin_jti from Cognito&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-1"><mxGeometry x="0" y="44" width="388" height="34" as="geometry"/></mxCell>
