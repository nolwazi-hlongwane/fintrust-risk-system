        <mxCell id="key-title" value="&lt;b&gt;How to read it&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="700" height="20" as="geometry"/></mxCell>
        <mxCell id="key-0-n" value="&lt;b&gt;«table»&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="848" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-0-m" value="one PostgreSQL table; each line is a column, as name : type" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="848" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="key-1-n" value="&lt;b&gt;«PK» underlined&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-1-m" value="primary key: identifies each row" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="868" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="key-2-n" value="&lt;b&gt;«FK» italic&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="888" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-2-m" value="foreign key: refers to the primary key of the table it is linked to" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="888" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="key-3-n" value="&lt;b&gt;[0..1]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="908" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-3-m" value="the column may be empty (NULL); every other column is NOT NULL" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="908" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="key-4-n" value="&lt;b&gt;{unique}&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="928" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-4-m" value="no two rows may hold the same value" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="928" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="key-5-n" value="&lt;b&gt;1 · 0..1 · 0..*&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="948" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-5-m" value="multiplicity at each end: exactly one, zero or one, zero or more" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="948" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="key-6-n" value="&lt;b&gt;owns ▸&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="968" width="150" height="18" as="geometry"/></mxCell>
        <mxCell id="key-6-m" value="the relationship&amp;#x27;s name, read in the direction of the arrowhead" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="196" y="968" width="560" height="18" as="geometry"/></mxCell>
        <mxCell id="checks" value="&lt;b&gt;Rules the diagram cannot show&lt;/b&gt;&lt;br&gt;CHECK constraints on every type, channel, level and status · amount &amp;gt; 0 · one alert per transaction · a resolved alert records who and when · only a manual flag names a person · ON DELETE RESTRICT on every foreign key.&lt;br&gt;&lt;br&gt;&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;transactions (account_id), (tx_date), (account_id, tx_date), (risk_level) · accounts (customer_id) · risk_events (account_id), (transaction_id) · alerts (status)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;fontColor=#232F3E;spacing=0;" vertex="1" parent="1"><mxGeometry x="800" y="820" width="350" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
