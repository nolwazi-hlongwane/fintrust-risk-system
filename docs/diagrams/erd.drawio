        <mxCell id="dd-1-2" value="status : S, end_reason : S&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;ACTIVE or ENDED, and why it ended&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-1"><mxGeometry x="0" y="112" width="388" height="34" as="geometry"/></mxCell>
        <mxCell id="dd-1-3" value="started_epoch, last_seen_epoch, ends_epoch : N&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;the 15-minute idle and 8-hour limits&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-1"><mxGeometry x="0" y="146" width="388" height="34" as="geometry"/></mxCell>
        <mxCell id="dd-1-4" value="user_agent : S&lt;br&gt;&lt;font color=&quot;#545B64&quot; style=&quot;font-size:10px&quot;&gt;which browser signed in&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=none;fillColor=none;fontColor=#232F3E;" vertex="1" parent="dd-1"><mxGeometry x="0" y="180" width="388" height="34" as="geometry"/></mxCell>
